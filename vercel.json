{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/app",
      "destination": "/workspace.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    }
  ],
  "redirects": [
    {
      "source": "/features/",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/app/",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/pricing",
      "permanent": true
    }
  ]
}
