{
  "name": "axiom",
  "version": "0.4.30",
  "private": true,
  "description": "Axiom — a focused presentation studio for your whole service",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never",
    "prepare": "node ../build.cjs && node bundle-updater.cjs",
    "prepackage": "node ../build.cjs && node bundle-updater.cjs",
    "prestart": "node ../build.cjs && node bundle-updater.cjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "playwright-core": "1.64.1"
  },
  "productName": "Axiom",
  "author": "Kay Jasanya",
  "build": {
    "appId": "com.kayjasanya.axiom",
    "productName": "Axiom",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json",
      "updates.cjs",
      "workspace.cjs",
      "media-store.cjs",
      "native-updater.cjs",
      "cloud-proxy.cjs"
    ],
    "artifactName": "Axiom-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "JasKay",
      "repo": "Axiom",
      "releaseType": "release"
    }
  }
}
