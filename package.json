{
    "name": "axiom",
    "version": "0.4.7",
    "private": true,
    "scripts": {
        "build": "node build.cjs",
        "test": "npm run build && node --test tests/*.test.cjs",
        "dev": "npm run build && node --env-file-if-exists=.env.local scripts/dev.cjs",
        "migrate": "node --env-file=.env.local scripts/migrate.cjs",
        "test:signup": "node --test tests/church-signup.integration.cjs",
        "test:integration": "node --env-file=.env.local --test tests/cloud.integration.cjs"
    },
    "dependencies": {
        "@vercel/blob": "^2.8.2",
        "@vercel/functions": "^3.10.1",
        "better-auth": "^1.7.10",
        "pdfjs-dist": "6.4.299",
        "pg": "^8.23.1",
        "pptx-browser": "4.1.5",
        "qrcode": "^1.5.4"
    },
    "engines": {
        "node": "24.x"
    },
    "devDependencies": {
        "@huggingface/transformers": "^4.3.1",
        "esbuild": "^0.28.2",
        "fake-indexeddb": "6.2.5",
        "jsdom": "30.1.2"
    }
}
